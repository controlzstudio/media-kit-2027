---
import '../styles/global.css';
import { textos } from '../data/conteudo';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Redes from '../components/Redes.astro';
import Publico from '../components/Publico.astro';
import Formatos from '../components/Formatos.astro';
import Parceiros from '../components/Parceiros.astro';
import Contato from '../components/Contato.astro';
import Rodape from '../components/Rodape.astro';

const t = textos.pt;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.roles} />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#120f14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/dennis-hero-2027.jpg" fetchpriority="high" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <Sobre />
      <Redes />
      <Publico />
      <Formatos />
      <Parceiros />
      <Contato />
    </main>
    <Rodape />
    <script>
      import '../scripts/interacoes';
    </script>
  </body>
</html>
