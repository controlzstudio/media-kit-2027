---
import '../styles/global.css';
import { contato, hero, sobre, redes, publico, formatos, parceiros, cta, rodape } from '../data/conteudo';

const titulo = `${hero.nome}, Mídia Kit 2027`;
const descricao = `${hero.frase} Proposta de publicidade para Dennis Santana / Control Z Studio.`;
const mailto = `mailto:${contato.email}?subject=${encodeURIComponent(contato.assunto)}`;
const pct = (n: number) => n.toLocaleString('pt-BR', { minimumFractionDigits: 1 });
const maiorIdade = Math.max(...publico.idade.map((i) => i.pct));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={hero.papeis.join(' · ')} />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/dennis-hero-v2.png" fetchpriority="high" />
  </head>
  <body>
    <header class="topo">
      <div class="container topo__linha">
        <img src="/logo.png" alt="Control Z Studio" width="64" height="64" class="topo__logo" />
        <a href={mailto} class="topo__cta">{cta.botao}</a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="hero__nome" aria-hidden="true">
          <span>DENNIS</span>
          <span>SANTANA</span>
        </div>
        <div class="container hero__grade">
          <div class="hero__texto">
            <p class="eyebrow">Mídia Kit 2027</p>
            <h1 class="hero__titulo">{hero.nome}</h1>
            <p class="hero__papeis">{hero.papeis.join(' · ')}</p>
            <p class="hero__frase">{hero.frase}</p>
            <a href={mailto} class="botao">{cta.botao} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero__foto">
            <img src="/dennis-hero-v2.png" alt="Dennis Santana" width="748" height="908" fetchpriority="high" />
          </div>
        </div>
      </section>

      <!-- Sobre -->
      <section id="sobre" class="secao">
        <div class="container">
          <div class="centro">
            <p class="eyebrow">{sobre.eyebrow}</p>
            <h2 class="titulo">{sobre.titulo}</h2>
            <p class="lead">{sobre.lead}</p>
          </div>
          <ul class="sobre__cards">
            {sobre.cards.map((c) => (
              <li class="card-sobre">
                <span class="card-sobre__badge">{c.badge}</span>
                <h3>{c.titulo}</h3>
                <p>{c.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Redes -->
      <section id="redes" class="secao redes">
        <div class="container redes__grade">
          <div>
            <p class="eyebrow">{redes.eyebrow}</p>
            <h2 class="titulo">{redes.titulo[0]}<br /><span class="destaque">{redes.titulo[1]}</span></h2>
            <div class="redes__texto">
              {redes.paragrafos.map((p) => <p>{p}</p>)}
              <p>{redes.destaque.antes}<strong>{redes.destaque.forte}</strong>{redes.destaque.depois}</p>
              <p>{redes.fechamento}</p>
            </div>
          </div>
          <ul class="redes__perfis">
            {redes.perfis.map((p) => (
              <li>
                <img src={p.img} alt={`Perfil ${p.rede} de Dennis Santana`} width={p.w} height={p.h} loading="lazy" />
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="perfil">
                  <span class="perfil__rede">{p.rede} · {p.handle}</span>
                  <span class="perfil__num">{p.seguidores}</span>
                  <span class="perfil__ver">Ver perfil ↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Público -->
      <section id="publico" class="secao">
        <div class="container">
          <div class="centro">
            <p class="eyebrow">{publico.eyebrow}</p>
            <h2 class="titulo">{publico.titulo}</h2>
            <p class="lead">{publico.lead}</p>
          </div>
          <div class="publico__grade">
            <div class="painel">
              <h3 class="painel__titulo">Gênero</h3>
              <div class="genero">
                {publico.genero.map((g, i) => (
                  <div class="genero__item">
                    <p class:list={['genero__num', i === 1 && 'genero__num--rosa']}>{pct(g.pct)}<small>%</small></p>
                    <p class="genero__rotulo">{g.rotulo}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="painel">
              <h3 class="painel__titulo">Faixa etária</h3>
              <ul class="idade">
                {publico.idade.map((f) => (
                  <li class="idade__barra" style={`--w:${Math.max((f.pct / maiorIdade) * 100, 46)}%`}>
                    <span class="idade__num">{pct(f.pct)}<small>%</small></span>
                    <span class="idade__rotulo">da audiência<br />{f.faixa}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Formatos -->
      <section id="formatos" class="secao">
        <div class="container">
          <div class="centro">
            <p class="eyebrow">{formatos.eyebrow}</p>
            <h2 class="titulo">{formatos.titulo}</h2>
            <p class="lead">{formatos.lead}</p>
          </div>
          <ol class="formatos__cards">
            {formatos.cards.map((c, i) => (
              <li class="card-formato">
                <span class="card-formato__num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{c.titulo}</h3>
                <p>{c.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Parceiros -->
      <section class="secao parceiros">
        <div class="container centro">
          <p class="eyebrow">{parceiros.eyebrow}</p>
          <h2 class="titulo">{parceiros.titulo}</h2>
        </div>
        <div class="faixa" aria-label="Marcas parceiras">
          <div class="faixa__trilho">
            {[0, 1].map((copia) => (
              <ul class="faixa__lista" aria-hidden={copia === 1 ? 'true' : undefined}>
                {parceiros.marcas.map((m) => (
                  <li><img src={m.img} alt={copia === 0 ? m.nome : ''} /></li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="secao contato">
        <div class="container contato__grade">
          <div>
            <p class="eyebrow">{cta.eyebrow}</p>
            <h2 class="titulo contato__titulo">{cta.titulo}</h2>
            <p class="lead">{cta.lead}</p>
            <a href={mailto} class="botao contato__botao">{cta.botao} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="ingresso" aria-hidden="true">
            <div class="ingresso__corpo">
              <p class="ingresso__selo">CTRLZ</p>
              <p class="ingresso__nome">DENNIS<br />SANTANA</p>
              <p class="ingresso__local">{cta.ingresso}</p>
            </div>
            <div class="ingresso__canhoto">
              <span>CtrlZ Studio · 2027</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="container rodape__linha">
        <img src="/logo.png" alt="Control Z Studio" width="48" height="48" loading="lazy" />
        <nav class="rodape__links" aria-label="Contato">
          <a href={contato.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href={contato.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a>
          <a href={contato.site} target="_blank" rel="noopener noreferrer">Site</a>
          <a href={`mailto:${contato.email}`}>E-mail</a>
          <a href="/politica-privacidade">Privacidade</a>
        </nav>
      </div>
      <p class="rodape__direitos">{rodape}</p>
    </footer>
  </body>
</html>

<style>
  /* Topo */
  .topo {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    padding-block: 20px;
  }
  .topo__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .topo__cta {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.625rem 1rem;
    border: 1px solid var(--linha);
    background: rgb(34 28 35 / 0.7);
    backdrop-filter: blur(8px);
  }
  .topo__cta:hover {
    background: var(--roxo);
    border-color: var(--roxo);
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: flex-end;
    background:
      radial-gradient(60% 50% at 75% 40%, rgb(146 60 153 / 0.35), transparent 70%),
      var(--ameixa-700);
  }
  .hero__nome {
    position: absolute;
    inset: auto 0 6%;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(4.5rem, 19vw, 17rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.12);
    user-select: none;
    pointer-events: none;
  }
  .hero__grade {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: 2rem;
    padding-top: 112px;
  }
  .hero__texto {
    padding-bottom: clamp(24px, 6vw, 96px);
  }
  .hero__titulo {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .hero__papeis {
    margin-top: 1.25rem;
    color: var(--lilas);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
  }
  .hero__frase {
    margin: 0.75rem 0 2rem;
    max-width: 30rem;
    color: var(--texto-2);
  }
  .hero__foto {
    justify-self: center;
    width: min(100%, 460px);
  }
  .hero__foto img {
    filter: drop-shadow(0 10px 40px rgb(0 0 0 / 0.5));
  }
  @media (min-width: 900px) {
    .hero__grade {
      grid-template-columns: 1.1fr 1fr;
    }
    .hero__foto {
      justify-self: end;
    }
  }

  /* Sobre */
  .sobre__cards {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .card-sobre {
    padding: 1.75rem;
    background: var(--ameixa-600);
    border-top: 3px solid var(--roxo);
  }
  .card-sobre__badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilas);
    background: var(--roxo-escuro);
    padding: 0.25rem 0.625rem;
    margin-bottom: 1.25rem;
  }
  .card-sobre h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .card-sobre p {
    color: var(--texto-2);
    font-size: 0.9375rem;
  }

  /* Redes */
  .redes {
    background: var(--ameixa-800);
  }
  .redes__grade {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .destaque {
    color: var(--roxo);
  }
  .redes__texto {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
    color: var(--texto-2);
  }
  .redes__texto strong {
    color: var(--texto);
  }
  .redes__perfis {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .redes__perfis img {
    filter: drop-shadow(0 20px 50px rgb(0 0 0 / 0.5));
  }
  .perfil {
    display: grid;
    gap: 0.125rem;
    margin-top: 1rem;
    text-decoration: none;
  }
  .perfil__rede {
    font-size: 0.8125rem;
    color: var(--texto-3);
  }
  .perfil__num {
    font-size: clamp(1.125rem, 2.4vw, 1.5rem);
    font-weight: 700;
  }
  .perfil__ver {
    font-size: 0.875rem;
    color: var(--roxo);
  }
  .perfil:hover .perfil__ver {
    color: var(--rosa);
  }
  @media (min-width: 900px) {
    .redes__grade {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  /* Público */
  .publico__grade {
    margin-top: 3rem;
    display: grid;
    gap: 1.25rem;
  }
  .painel {
    padding: clamp(24px, 4vw, 48px);
    background: var(--ameixa-600);
  }
  .painel__titulo {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }
  .genero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    text-align: center;
  }
  .genero__item + .genero__item {
    border-left: 1px solid var(--linha);
  }
  .genero__num {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--roxo);
  }
  .genero__num--rosa {
    color: var(--rosa);
  }
  .genero__num small,
  .idade__num small {
    font-size: 0.45em;
    vertical-align: top;
    margin-left: 2px;
  }
  .genero__rotulo {
    margin-top: 0.75rem;
    color: var(--texto-2);
  }
  .idade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .idade__barra {
    width: var(--w);
    min-width: fit-content;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    background: var(--roxo);
  }
  .idade__num {
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
  }
  .idade__rotulo {
    font-size: 0.8125rem;
    line-height: 1.3;
    color: rgb(255 255 255 / 0.8);
  }
  @media (min-width: 900px) {
    .publico__grade {
      grid-template-columns: 1fr 1.3fr;
    }
  }

  /* Formatos */
  .formatos__cards {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .card-formato {
    padding: 1.75rem;
    background: var(--roxo-escuro);
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .card-formato:hover {
    background: var(--roxo-medio);
    transform: translateY(-4px);
  }
  .card-formato__num {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--roxo);
    margin-bottom: 2rem;
  }
  .card-formato h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .card-formato p {
    color: rgb(255 255 255 / 0.7);
    font-size: 0.9375rem;
  }

  /* Parceiros */
  .faixa {
    margin-top: 3.5rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .faixa__trilho {
    display: flex;
    width: max-content;
    animation: rolar 32s linear infinite;
  }
  .faixa__lista {
    list-style: none;
    margin: 0;
    padding: 0 clamp(32px, 6vw, 48px) 0 0;
    display: flex;
    align-items: center;
    gap: clamp(32px, 6vw, 48px);
  }
  .faixa__lista img {
    height: 36px;
    width: auto;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }
  .faixa__lista img:hover {
    opacity: 1;
  }
  .faixa:hover .faixa__trilho {
    animation-play-state: paused;
  }
  @keyframes rolar {
    to {
      transform: translateX(-50%);
    }
  }

  /* Contato */
  .contato {
    background: linear-gradient(to bottom, var(--ameixa-800), var(--ameixa-900));
  }
  .contato__grade {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .contato__titulo {
    font-size: clamp(2rem, 5vw, 3.25rem);
  }
  .contato__botao {
    margin-top: 2.5rem;
  }
  .ingresso {
    display: flex;
    max-width: 460px;
    width: 100%;
    justify-self: center;
    transform: rotate(-4deg);
    filter: drop-shadow(0 20px 40px rgb(0 0 0 / 0.5));
  }
  .ingresso__corpo {
    flex: 1;
    padding: 1.75rem;
    background: var(--roxo);
    border-right: 2px dashed rgb(255 255 255 / 0.35);
  }
  .ingresso__selo {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--lilas);
  }
  .ingresso__nome {
    margin: 1.25rem 0;
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .ingresso__local {
    font-size: 0.875rem;
    color: var(--lilas-claro);
  }
  .ingresso__canhoto {
    width: 64px;
    display: grid;
    place-items: center;
    background: var(--roxo-escuro);
  }
  .ingresso__canhoto span {
    writing-mode: vertical-rl;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lilas);
  }
  @media (min-width: 900px) {
    .contato__grade {
      grid-template-columns: 1fr 1fr;
    }
    .ingresso {
      justify-self: end;
    }
  }

  /* Rodapé */
  .rodape {
    background: var(--ameixa-900);
    border-top: 1px solid var(--linha);
    padding-block: 2.5rem;
  }
  .rodape__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .rodape__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .rodape__links a {
    color: var(--texto-3);
    text-decoration: none;
    font-size: 0.875rem;
  }
  .rodape__links a:hover {
    color: var(--roxo);
  }
  .rodape__direitos {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.25);
  }
</style>
