---
import { contato, textos } from '../data/conteudo';
import Icone from './Icone.astro';

const t = textos.pt;
---

<footer class="rodape">
  <div class="container rodape__linha">
    <a href="#topo" class="rodape__logo">
      <img src="/logo-ctrlz.png" alt="Control Z Studio" width="512" height="101" loading="lazy" />
    </a>
    <nav class="rodape__nav" data-t-attr="aria-label:footerNav" aria-label={t.footerNav}>
      <a href={contato.instagram} target="_blank" rel="noopener noreferrer" class="redondo" aria-label="Instagram"><Icone nome="instagram" /></a>
      <a href={contato.tiktok} target="_blank" rel="noopener noreferrer" class="redondo" aria-label="TikTok"><Icone nome="tiktok" /></a>
      <a href={contato.site} target="_blank" rel="noopener noreferrer" class="redondo" data-t-attr="aria-label:footerSite" aria-label={t.footerSite}><Icone nome="globo" /></a>
      <a href={`mailto:${contato.email}`} class="redondo" data-t-attr="aria-label:footerEmail" aria-label={t.footerEmail}><Icone nome="email" /></a>
      <a href="/politica-privacidade" class="rodape__privacidade" data-t="footerPrivacy">{t.footerPrivacy}</a>
    </nav>
  </div>
  <p class="rodape__copy" data-t="copy">{t.copy}</p>
</footer>

<style>
  .rodape {
    background: #0e0c10;
    border-top: 1px solid var(--border);
    padding-block: 2.5rem 2rem;
  }
  .rodape__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .rodape__logo img {
    height: 28px;
    width: auto;
  }
  .rodape__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }
  .redondo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--text-muted);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.25s var(--ease-out);
  }
  .redondo:hover {
    color: var(--purple-light);
    border-color: var(--purple-light);
    transform: translateY(-2px);
  }
  .rodape__privacidade {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: 0.5rem;
    color: var(--text-subtle);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .rodape__privacidade:hover {
    color: var(--purple-light);
  }
  .rodape__copy {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }
</style>
