---
import { PROPOSAL_URL, numeros, textos } from '../data/conteudo';
import { milhares } from '../scripts/formato';
import Icone from './Icone.astro';

const t = textos.pt;
const faixa = 'DENNIS SANTANA · DENNIS SANTANA · ';
---

<section id="topo" class="hero">
  <div class="hero__marquee" aria-hidden="true">
    <div class="hero__marquee-trilho">
      <span>{faixa}</span><span>{faixa}</span>
    </div>
  </div>

  <div class="container hero__grade">
    <div class="hero__texto">
      <h1 class="hero__titulo entra" style="--d: 0.1s">DENNIS<br />SANTANA</h1>
      <p class="hero__papeis entra" style="--d: 0.25s" data-t="roles">{t.roles}</p>
      <div class="hero__acoes entra" style="--d: 0.4s">
        <a href={PROPOSAL_URL} class="botao"><span data-t="cta">{t.cta}</span> <span class="seta" aria-hidden="true">↗</span></a>
        <a href="#redes" class="botao botao--contorno" data-t="seeNumbers">{t.seeNumbers}</a>
        <a href="#sobre" class="rolar" data-t-attr="aria-label:scrollDown" aria-label={t.scrollDown}>
          <span class="rolar__mouse"><span class="rolar__bolinha"></span></span>
        </a>
      </div>
    </div>

    <div class="hero__visual entra" style="--d: 0.55s">
      <div class="moldura">
        <div class="moldura__brilho" aria-hidden="true"></div>
        <svg class="moldura__anel" viewBox="0 0 500 500" aria-hidden="true">
          <defs>
            <path id="anel-caminho" d="M250,250 m-226,0 a226,226 0 1,1 452,0 a226,226 0 1,1 -452,0" />
          </defs>
          <text>
            <textPath href="#anel-caminho" textLength="1415" lengthAdjust="spacing" data-t="ring">{t.ring}</textPath>
          </text>
        </svg>
        <svg class="moldura__pontos" viewBox="0 0 500 500" aria-hidden="true">
          <circle cx="250" cy="250" r="198" />
        </svg>
        <div class="moldura__foto">
          <img src="/dennis-hero-2027.jpg" alt={t.photoAlt} width="750" height="1000" fetchpriority="high" />
        </div>
        <div class="chip chip--ig" aria-hidden="true">
          <Icone nome="instagram" />
          <span data-num={numeros.instagram.seguidores} data-fmt="milhares">{milhares(numeros.instagram.seguidores, 'pt')}</span>
        </div>
        <div class="chip chip--tt" aria-hidden="true">
          <Icone nome="tiktok" />
          <span data-num={numeros.tiktok.seguidores} data-fmt="milhares-exato">{milhares(numeros.tiktok.seguidores, 'pt', false)}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(90% 80% at 75% 10%, #3a1f47 0%, #1a1320 45%, #120f14 75%);
  }

  /* Nome vazado rolando ao fundo */
  .hero__marquee {
    position: absolute;
    inset: 72% 0 auto;
    transform: translateY(-50%);
    pointer-events: none;
    user-select: none;
  }
  .hero__marquee-trilho {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .hero__marquee span {
    font-size: clamp(120px, 20vw, 260px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: pre;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(197 139 224 / 0.22);
  }

  .hero__grade {
    position: relative;
    display: grid;
    align-items: center;
    gap: 3rem;
    min-height: 600px;
    padding-block: clamp(40px, 7vw, 72px) clamp(32px, 4vw, 48px);
  }

  .hero__titulo {
    font-size: clamp(64px, 11vw, 128px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }
  .hero__papeis {
    margin-top: 1.5rem;
    font-size: 20px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .hero__acoes {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  /* Ícone de rolar */
  .rolar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 52px;
  }
  .rolar__mouse {
    position: relative;
    width: 24px;
    height: 38px;
    border: 2px solid var(--text-subtle);
    border-radius: 12px;
    transition: border-color 0.2s ease;
  }
  .rolar:hover .rolar__mouse {
    border-color: var(--purple-light);
  }
  .rolar__bolinha {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--purple-light);
    animation: bolinha 1.8s ease-in-out infinite;
  }

  /* Moldura circular */
  .hero__visual {
    justify-self: center;
    width: 100%;
    max-width: 500px;
  }
  .moldura {
    position: relative;
    aspect-ratio: 1;
    animation: flutuar 6s ease-in-out infinite;
  }
  .moldura__brilho {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: var(--purple);
    filter: blur(60px);
    opacity: 0.45;
    animation: pulsar 6s ease-in-out infinite;
  }
  .moldura__anel,
  .moldura__pontos {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .moldura__anel {
    animation: girar 40s linear infinite;
  }
  .moldura__anel text {
    fill: var(--purple-light);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .moldura__pontos {
    animation: girar 70s linear infinite reverse;
  }
  .moldura__pontos circle {
    fill: none;
    stroke: var(--purple);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 10;
  }
  .moldura__foto {
    position: absolute;
    inset: 13%;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--purple);
    background: var(--purple-dark);
  }
  .moldura__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transition: transform 0.6s var(--ease-out);
  }
  .moldura:hover .moldura__foto img {
    transform: scale(1.06);
  }

  .chip {
    position: absolute;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: rgb(29 24 32 / 0.92);
    border: 1px solid #3a3140;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.0625rem;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.45);
  }
  .chip :global(svg) {
    color: var(--purple-light);
  }
  .chip--ig {
    left: -4%;
    top: 22%;
    animation: chip-a 5s ease-in-out infinite;
  }
  .chip--tt {
    right: -4%;
    bottom: 20%;
    animation: chip-b 7s ease-in-out infinite;
  }

  /* Entrada escalonada */
  .entra {
    animation: entrar 0.9s var(--ease-out) var(--d, 0s) both;
  }

  @media (min-width: 820px) {
    .chip {
      display: inline-flex;
    }
  }
  @media (min-width: 900px) {
    .hero__marquee {
      top: 50%;
    }
    .hero__grade {
      grid-template-columns: 1.05fr 1fr;
    }
    .hero__visual {
      justify-self: end;
    }
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes flutuar {
    0%,
    100% {
      transform: translateY(-14px);
    }
    50% {
      transform: translateY(14px);
    }
  }
  @keyframes pulsar {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.05);
    }
  }
  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes bolinha {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes chip-a {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-10px) rotate(-2deg);
    }
  }
  @keyframes chip-b {
    0%,
    100% {
      transform: translateY(0) rotate(3deg);
    }
    50% {
      transform: translateY(12px) rotate(5deg);
    }
  }
</style>
