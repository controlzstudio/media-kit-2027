---
import { parceiros, textos } from '../data/conteudo';

const t = textos.pt;
---

<section class="secao parceiros">
  <div class="container">
    <div class="parceiros__topo">
      <p class="kicker rv" data-t="brandKicker">{t.brandKicker}</p>
      <h2 class="titulo rv rv-2" data-t="brandTitle">{t.brandTitle}</h2>
    </div>

    <ul class="logos">
      {parceiros.map((m, i) => (
        <li class:list={['logos__item', 'rv', `rv-${(i % 4) + 1}`]}>
          <img src={m.img} alt={m.nome} loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .parceiros__topo {
    text-align: center;
  }
  .logos {
    margin-top: 3.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(28px, 5vw, 56px) clamp(32px, 6vw, 72px);
  }
  .logos__item {
    display: grid;
    place-items: center;
    min-height: 44px;
  }
  .logos__item img {
    height: 34px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.5;
    transition: opacity 0.25s ease, transform 0.25s var(--ease-out);
  }
  .logos__item img:hover {
    opacity: 1;
    transform: scale(1.06);
  }
  @media (max-width: 560px) {
    .logos__item img {
      height: 26px;
      max-width: 130px;
    }
  }
</style>
