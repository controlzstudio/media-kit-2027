---
import { parceiros, textos } from '../data/conteudo';

const t = textos.pt;
---

<section class="secao parceiros">
  <div class="container parceiros__topo">
    <p class="kicker rv" data-t="brandKicker">{t.brandKicker}</p>
    <h2 class="titulo rv rv-2" data-t="brandTitle">{t.brandTitle}</h2>
  </div>

  <div class="faixa rv rv-3">
    <div class="faixa__trilho">
      {[0, 1].map((copia) => (
        <ul class="faixa__lista" aria-hidden={copia === 1 ? 'true' : undefined}>
          {parceiros.map((m) => (
            <li><img src={m.img} alt={copia === 0 ? m.nome : ''} /></li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .parceiros__topo {
    text-align: center;
  }
  .faixa {
    margin-top: 3.5rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .faixa__trilho {
    display: flex;
    width: max-content;
    animation: faixa 38s linear infinite;
  }
  .faixa:hover .faixa__trilho {
    animation-play-state: paused;
  }
  .faixa__lista {
    display: flex;
    align-items: center;
    gap: clamp(40px, 7vw, 80px);
    padding-right: clamp(40px, 7vw, 80px);
    padding-block: 0.75rem;
  }
  .faixa__lista img {
    height: 34px;
    width: auto;
    max-width: none;
    filter: brightness(0) invert(1);
    opacity: 0.5;
    transition: opacity 0.25s ease, transform 0.25s var(--ease-out);
  }
  .faixa__lista img:hover {
    opacity: 1;
    transform: scale(1.06);
  }
  @keyframes faixa {
    to {
      transform: translateX(-50%);
    }
  }
</style>
